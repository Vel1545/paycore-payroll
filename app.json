{
  "expo": {
    "name": "paycore-payroll",
    "slug": "paycore-payroll",
    "version": "1.0.0",
    "scheme": "paycore",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.femi.payroll",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.femi.payroll",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_ANDROID_API_KEY"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "e322810c-4279-4793-81f4-2a48e9114765"
      }
    },
    "plugins": [
      "expo-updates",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-sharing",
      "expo-splash-screen",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Payroll to use the camera for the attendance selfie.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Payroll to use your location to verify you are at the office when you check in or out.",
          "locationAlwaysAndWhenInUsePermission": "Allow Payroll to track location during shifts.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Payroll to use your photos to set your profile picture.",
          "cameraPermission": "Allow Payroll to take your profile picture."
        }
      ],
      ["expo-notifications",
       {
          "icon": "./assets/notification-icon.png",
          "color": "#1E40AF",
          "sounds": ["./assets/bell.wav"]
        }
      ],
      "expo-audio"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e322810c-4279-4793-81f4-2a48e9114765"
    }
  }
}